# Server-only key. Never put it in VITE_* or source code.
FAVORIT_API_KEY=
# Endpoint from the supplied documentation, accessed over HTTPS.
FAVORIT_API_URL=https://api.favorit-parts.ru/hs/hsprice/
# Default is live. npm run dev:demo explicitly enables offline demo data.
VITE_API_MODE=live
# Optional gateway override, NOT the provider URL.
VITE_API_URL=/api/parts
