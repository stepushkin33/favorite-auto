# Demo data is explicitly enabled until the provider's documentation is available.
VITE_API_MODE=demo
# For live mode, set VITE_API_MODE=live and configure a same-origin API gateway.
VITE_API_BASE_URL=/api
VITE_API_BRANDS_PATH=/brands
VITE_API_OFFERS_PATH=/offers
# Optional upstream for the development proxy. Never put private API keys in VITE_*.
API_PROXY_TARGET=
